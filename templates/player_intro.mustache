{{!
    @template mod_labeldiagram/player_intro

    Start screen for a mode: what to expect (or the Test requirements) and how to play.
    Rendered by amd/src/player.js; strings are passed in already resolved.

    Context variables required for this template:
    * mode - study, practice or test.
    * badgeicon - Static SVG icon markup from the plugin.
    * modename, title, sub - Hero texts.
    * heading - Heading of the list.
    * items - List items (icon, text, key).
    * howtoheading, howto - How to play.
    * study - True in Study mode (changes the demo animation).
    * handicon - Static SVG icon markup.
    * back, go - Button labels and icons.

    Example context (json):
    {
        "mode": "test",
        "badgeicon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>",
        "modename": "Test",
        "title": "Test yourself",
        "sub": "Place every label, then submit.",
        "heading": "To pass",
        "items": [{"icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>", "text": "You need 70% to pass", "key": true}],
        "howtoheading": "How to play",
        "study": false,
        "handicon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>",
        "howto": "Drag each label onto its numbered point.",
        "back": {"label": "Back", "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>"},
        "go": {"label": "Start", "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>"}
    }
}}
<div class="ld-intro ld-intro-{{mode}}">
    <div class="ld-intro-hero">
        <div class="ld-intro-badge">{{{badgeicon}}}</div>
        <span class="ld-modetag ld-modetag-{{mode}}">{{modename}}</span>
        <h3 class="ld-intro-title">{{title}}</h3>
        <p class="ld-intro-sub">{{sub}}</p>
    </div>
    <div class="ld-intro-grid">
        <div class="ld-intro-col">
            <h4>{{heading}}</h4>
            <ul class="ld-intro-list">
                {{#items}}
                <li class="{{#key}}is-key{{/key}}"><span class="ld-intro-ic">{{{icon}}}</span><span>{{text}}</span></li>
                {{/items}}
            </ul>
        </div>
        <div class="ld-intro-col ld-intro-how">
            <h4>{{howtoheading}}</h4>
            <div class="ld-intro-demo{{#study}} is-study{{/study}}" aria-hidden="true">
                <span class="ld-demo-chip">Aa</span>
                <svg class="ld-demo-path" viewBox="0 0 160 60"><path d="M20 44 C60 44 90 16 140 16"/></svg>
                <span class="ld-demo-pin">1</span>
                <span class="ld-demo-hand">{{{handicon}}}</span>
            </div>
            <p>{{howto}}</p>
        </div>
    </div>
    <div class="ld-intro-actions">
        <button type="button" class="ld-btn ld-btn-ghost" data-action="back">{{{back.icon}}}<span>{{back.label}}</span></button>
        <button type="button" class="ld-btn ld-btn-primary ld-btn-lg" data-action="go"><span>{{go.label}}</span>{{{go.icon}}}</button>
    </div>
</div>
