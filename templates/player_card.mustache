{{!
    @template mod_labeldiagram/player_card

    The "What it does" card for one labelled part, used by the player and by the editor preview.

    Context variables required for this template:
    * num - Marker number.
    * infoicon - Static SVG icon markup.
    * eyebrow - "What it does".
    * titlehtml - Part name, already formatted or escaped.
    * bodyhtml - Explanation, formatted by format_text() on the server or escaped Markdown in the editor.
    * empty - Text shown when there is no explanation yet (editor only).
    * close - Close button (label, icon), or false.

    Example context (json):
    {
        "num": 1,
        "infoicon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>",
        "eyebrow": "What it does",
        "titlehtml": "Thrust reverser",
        "bodyhtml": "<p>Redirects airflow <strong>forwards</strong>.</p>",
        "empty": "",
        "close": {"label": "Close", "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>"}
    }
}}
<div class="ld-card-accent"></div>
<div class="ld-card-head">
    <span class="ld-card-num">{{num}}</span>
    <div class="ld-card-titles">
        <span class="ld-card-eyebrow">{{{infoicon}}}{{eyebrow}}</span>
        <h4 class="ld-card-title">{{{titlehtml}}}</h4>
    </div>
</div>
<div class="ld-card-body">{{{bodyhtml}}}{{^bodyhtml}}<em class="ld-mini">{{empty}}</em>{{/bodyhtml}}</div>
{{#close}}
<button type="button" class="ld-iconbtn ld-card-close" data-action="close" aria-label="{{label}}">{{{icon}}}</button>
{{/close}}
