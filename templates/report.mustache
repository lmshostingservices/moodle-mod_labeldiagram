{{!
    @template mod_labeldiagram/report

    Teacher report: summary figures, per-part difficulty and attempt management.

    Context variables required for this template:
    * tabs - Report tabs (url, label, active).
    * modes - Mode switch (url, label, active).
    * groupmenu - Rendered group selector HTML (may be empty).
    * kpis - Summary figures (label, value).
    * parts - Per-part tab data, or false.
    * attempts - Attempts tab data, or false.

    Example context (json):
    {
        "tabs": [{"url": "#", "label": "Part difficulty", "active": true}, {"url": "#", "label": "Attempts", "active": false}],
        "modes": [{"url": "#", "label": "Test", "active": true}, {"url": "#", "label": "Practice", "active": false}],
        "groupmenu": "",
        "kpis": [{"label": "Students", "value": "2"}, {"label": "Average score", "value": "62.9%"}],
        "parts": {
            "help": "The percentage of responses that were wrong for each part.",
            "test": true,
            "slides": [{
                "title": "Engine",
                "rows": [
                    {"num": 1, "name": "Fan", "color": "#6366F1", "responses": 5, "hasdata": true,
                     "wrong": {"pct": 20, "label": 20, "class": ""},
                     "studentswrong": {"pct": 50, "label": 50, "class": " is-mid"}, "studentsof": "1 of 2 students",
                     "blank": 0, "confused": "Nozzle (1)"},
                    {"num": 2, "name": "Nozzle", "color": "#0EA5E9", "responses": 0, "hasdata": false}
                ]
            }]
        },
        "attempts": false
    }
}}
<div class="ld-report">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <div class="ld-tabs">
            {{#tabs}}<a href="{{{url}}}" class="{{#active}}is-on{{/active}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>{{/tabs}}
        </div>
        <div class="ld-tabs">
            {{#modes}}<a href="{{{url}}}" class="{{#active}}is-on{{/active}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>{{/modes}}
        </div>
    </div>
    {{{groupmenu}}}
    <div class="ld-kpis">
        {{#kpis}}
        <div class="ld-kpi"><span>{{label}}</span><strong>{{value}}</strong></div>
        {{/kpis}}
    </div>

    {{#parts}}
    <h3>{{#str}} reportparts, mod_labeldiagram {{/str}}</h3>
    <div class="ld-help">{{help}}</div>
    {{#slides}}
    <h3>{{{title}}}</h3>
    <div class="table-responsive">
        <table class="ld-table generaltable">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">{{#str}} part, mod_labeldiagram {{/str}}</th>
                    <th scope="col">{{#str}} responses, mod_labeldiagram {{/str}}</th>
                    {{#test}}
                    <th scope="col">{{#str}} pctwrong, mod_labeldiagram {{/str}}</th>
                    <th scope="col">{{#str}} pctstudentswrong, mod_labeldiagram {{/str}}</th>
                    <th scope="col">{{#str}} leftblank, mod_labeldiagram {{/str}}</th>
                    <th scope="col">{{#str}} mostconfused, mod_labeldiagram {{/str}}</th>
                    {{/test}}
                    {{^test}}
                    <th scope="col">{{#str}} firsttry, mod_labeldiagram {{/str}}</th>
                    <th scope="col">{{#str}} avgtries, mod_labeldiagram {{/str}}</th>
                    <th scope="col">{{#str}} maxtries, mod_labeldiagram {{/str}}</th>
                    {{/test}}
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    <td>{{num}}</td>
                    <td><span class="ld-dotcolor" style="background: {{color}}"></span>{{{name}}}</td>
                    <td>{{responses}}</td>
                    {{#hasdata}}
                    {{#test}}
                    <td>{{#wrong}}{{> mod_labeldiagram/report_bar }}{{/wrong}}</td>
                    <td>{{#studentswrong}}{{> mod_labeldiagram/report_bar }}{{/studentswrong}}<div class="ld-mini">{{studentsof}}</div></td>
                    <td>{{blank}}</td>
                    <td>{{{confused}}}</td>
                    {{/test}}
                    {{^test}}
                    <td>{{#firsttry}}{{> mod_labeldiagram/report_bar }}{{/firsttry}}</td>
                    <td>{{avgtries}}</td>
                    <td>{{maxtries}}</td>
                    {{/test}}
                    {{/hasdata}}
                    {{^hasdata}}
                    <td>-</td><td>-</td><td>-</td>{{#test}}<td>-</td>{{/test}}
                    {{/hasdata}}
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/slides}}
    {{/parts}}

    {{#attempts}}
    <h3>{{#str}} reportattempts, mod_labeldiagram {{/str}}</h3>
    {{#regradebutton}}<div class="ld-report-actions">{{{regradebutton}}}</div>{{/regradebutton}}
    {{^rows}}{{{noattempts}}}{{/rows}}
    {{#hasrows}}
    {{{pagingbar}}}
    <form method="post" action="{{{actionurl}}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="delete">
        <div class="table-responsive">
            <table class="ld-table generaltable">
                <thead>
                    <tr>
                        <th scope="col">{{#canmanage}}<input type="checkbox" value="1" data-action="toggle" data-toggle="{{togglemaster}}" data-togglegroup="ld-attempts" aria-label="{{#str}} selectall {{/str}}">{{/canmanage}}</th>
                        <th scope="col">{{#str}} fullname {{/str}}</th>
                        {{#identityheads}}<th scope="col">{{.}}</th>{{/identityheads}}
                        <th scope="col">{{#str}} attempt, mod_labeldiagram {{/str}}</th>
                        <th scope="col">{{#str}} state, mod_labeldiagram {{/str}}</th>
                        <th scope="col">{{#str}} started, mod_labeldiagram {{/str}}</th>
                        <th scope="col">{{#str}} duration, mod_labeldiagram {{/str}}</th>
                        <th scope="col">{{#str}} correct, mod_labeldiagram {{/str}}</th>
                        <th scope="col">{{#str}} percentage, grades {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <td>{{#canmanage}}<input type="checkbox" name="attemptids[]" value="{{id}}" data-action="toggle" data-toggle="{{toggletarget}}" data-togglegroup="ld-attempts" aria-label="{{fullname}}">{{/canmanage}}</td>
                        <td><a href="{{{profileurl}}}">{{fullname}}</a></td>
                        {{#identity}}<td>{{.}}</td>{{/identity}}
                        <td><span class="ld-pill is-{{mode}}">{{modename}} #{{attempt}}</span></td>
                        <td>{{state}}</td>
                        <td>{{started}}</td>
                        <td>{{duration}}</td>
                        <td>{{correct}} / {{total}}</td>
                        <td>{{#grade}}{{> mod_labeldiagram/report_bar }}{{/grade}}{{^grade}}-{{/grade}}</td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
        {{#canmanage}}
        <button type="submit" class="ld-btn ld-btn-danger mt-2" data-modal="confirmation" data-modal-type="delete"
            data-modal-title-str='["delete", "core"]' data-modal-content-str='["confirmdeleteattempts", "mod_labeldiagram"]'
            data-modal-yes-button-str='["delete", "core"]'>{{#str}} deleteselected, mod_labeldiagram {{/str}}</button>
        {{/canmanage}}
    </form>
    {{{pagingbar}}}
    {{{download}}}
    {{/hasrows}}
    {{/attempts}}
</div>
